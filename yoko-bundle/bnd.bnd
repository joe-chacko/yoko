-include ~../config/bnd/common.bnd

Bundle-Description: Apache Yoko OSGi Uber-Bundle

# Explicit symbolic name — overrides the common.bnd derived name
Bundle-SymbolicName: org.apache.yoko

# Embed all subproject JARs directly into this bundle
-includeresource: \
    @${project(':yoko-osgi').jar.archivePath}, \
    @${project(':yoko-spec-corba').jar.archivePath}, \
    @${project(':yoko-rmi-spec').jar.archivePath}, \
    @${project(':yoko-util').jar.archivePath}, \
    @${project(':yoko-rmi-impl').jar.archivePath}, \
    @${project(':yoko-core').jar.archivePath}

# API packages (CORBA/OMG/RMI specs)
Export-Package: \
    org.omg.*;version=2.4, \
    javax.rmi.*;version=2.4, \
    org.omg.stub.java.rmi;version=2.4, \
    org.apache.geronimo.interop;version=1.0, \
    org.apache.yoko;version=1.0, \
    org.apache.yoko.rmispec.*;version=1.0, \
    org.apache.yoko.rmi.*;version=1.0, \
    org.apache.yoko.osgi.*;version=1.0.0, \
    org.apache.yoko.codecs, \
    org.apache.yoko.giop, \
    org.apache.yoko.io, \
    org.apache.yoko.logging, \
    org.apache.yoko.util.*, \
    org.apache.yoko.orb.*

# Optional sun.* imports that may not be present at runtime
Import-Package: \
    sun.misc;resolution:=optional, \
    sun.reflect;resolution:=optional, \
    *
